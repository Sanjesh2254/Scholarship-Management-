>\r\n        {% else %}\r\n            N/A\r\n        {% endif %}\r\n    </td><tr>\r\n    <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>12th Marksheet</strong></td>\r\n    <td style=\"border: 1px solid #ddd; padding: 8px;\">\r\n        {% if doc.twelfth_marksheet %}\r\n            \r\n            <!-- Show image preview -->\r\n            <img src=\"{{ doc.twelfth_marksheet }}\" style=\"max-width:200px; margin-top:5px; border:1px solid #ccc; padding:2px;\">\r\n        {% else %}\r\n            N/A\r\n        {% endif %}\r\n    </td>\r\n    <tr>\r\n    <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>Semester Marksheet</strong></td>\r\n    <td style=\"border: 1px solid #ddd; padding: 8px;\">\r\n        {% if doc.previous_semester_marksheet %}\r\n            \r\n            <!-- Show image preview -->\r\n            <img src=\"{{ doc.previous_semester_marksheet }}\" style=\"max-width:200px; margin-top:5px; border:1px solid #ccc; padding:2px;\">\r\n        {% else %}\r\n            N/A\r\n        {% endif %}\r\n    </td>\r\n</tr>\r\n  <tr>\r\n    <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>Passbook</strong></td>\r\n    <td style=\"border: 1px solid #ddd; padding: 8px;\">\r\n        {% if doc.passbook %}\r\n            \r\n            <!-- Show image preview -->\r\n            <img src=\"{{ doc.passbook }}\" style=\"max-width:200px; margin-top:5px; border:1px solid #ccc; padding:2px;\">\r\n        {% else %}\r\n            N/A\r\n        {% endif %}\r\n    </td>\r\n</tr>\r\n  <tr>\r\n    <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>Tamilmedium Certificate</strong></td>\r\n    <td style=\"border: 1px solid #ddd; padding: 8px;\">\r\n        {% if doc.tamil_medium_certificate %}\r\n            \r\n            <!-- Show image preview -->\r\n            <img src=\"{{ doc.tamil_medium_certificate }}\" style=\"max-width:200px; margin-top:5px; border:1px solid #ccc; padding:2px;\">\r\n        {% else %}\r\n            N/A\