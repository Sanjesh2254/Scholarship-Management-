  "html": "<div style=\"font-family: Arial, sans-serif; color: #333; padding: 20px;\">\r\n\r\n    <!-- Header with Logo -->\r\n    <div style=\"text-align: center; padding-bottom: 15px; border-bottom: 2px solid #4CAF50;\">\r\n        <img src=\"https://media.istockphoto.com/id/1366851749/vector/scholarship-banner.jpg?s=612x612&w=0&k=20&c=qFKJiZGmD97vYxqi0qiTolbHV3fDgjYuhNtTbj7cndM=\" \r\n             alt=\"Scholarship Logo\" \r\n             style=\"max-height: 100px; margin-bottom: 10px;\">\r\n        <h2 style=\"color: #4CAF50; margin: 0;\">Scholarship Application</h2>\r\n    </div>\r\n\r\n    <!-- Application Details -->\r\n    <h3 style=\"margin-top: 20px;\">Application Details</h3>\r\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\r\n        <tr>\r\n            <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>Application ID</strong></td>\r\n            <td style=\"border: 1px solid #ddd; padding: 8px;\">{{ doc.name }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>Scholarship Name</strong></td>\r\n            <td style=\"border: 1px solid #ddd; padding: 8px;\">{{ doc.scholarship_name }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>Applicant</strong></td>\r\n            <td style=\"border: 1px solid #ddd; padding: 8px;\">{{ doc.applicant }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>Application Date</strong></td>\r\n            <td style=\"border: 1px solid #ddd; padding: 8px;\">{{ doc.application_date }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"border: 1px solid #ddd; padding: 8px;\"><strong>Status</strong></td>\r\n            <td style=\"border: 1px solid #ddd; padding: 8px;\">{{ doc.status }}</td>\r\n        </tr>\r\n        <tr>\r\n    \r\n\r\n    </table>\r\n        <h3 style=\"margin-to